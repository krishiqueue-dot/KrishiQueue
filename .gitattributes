# Normalise to LF in the repository and on checkout, so Windows and
# Linux contributors do not produce whole-file diffs.
* text=auto eol=lf

# Keep binaries untouched.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.mp4  binary
*.webm binary
*.woff  binary
*.woff2 binary
*.pdf  binary

# Generated — collapse in pull request diffs.
package-lock.json linguist-generated=true
